# AI Provider Selection:
# PRIMARY_AI_PROVIDER: "openrouter" (default) or "gemini"
# BACKUP_AI_PROVIDER: "gemini", "openrouter", or "none"
PRIMARY_AI_PROVIDER="openrouter"
BACKUP_AI_PROVIDER="gemini"
ENABLE_BACKUP_PROVIDER="true"

# OPENROUTER_API_KEY: Primary AI provider key for server-side 4-agent workflow execution.
# Configure this in .env or the AI Studio Secrets panel.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openrouter/free"

# GEMINI_API_KEY: Optional backup AI provider key for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


